  async function cleanup(){setActive(false);await sleep(250);if(!backup.current){say('No backup to restore');return;}const before=backup.current;await localExecutionTransaction(()=>before.data);localStorage.clear();for(const [k,v]of before.storage)localStorage.setItem(k,v);backup.current=null;setPrepared(false);say('CLEANED: original IndexedDB object and every localStorage byte restored');}
  return <main style={{padding:20,fontFamily:'sans-serif'}}><h1>UX11 isolated localhost QA</h1><p>Synthetic local data only. Stop if existing login or actual records. Always use cleanup.</p><button disabled={running||prepared} onClick={()=>void run()}>Run native store and UI QA</button><button disabled={running} onClick={()=>void cleanup()}>Restore original browser data</button><ol>{events.map((e,i)=><li key={i}>{e}</li>)}</ol>{active&&<iframe ref={frame} title="Actual-time QA application" style={{width:'100%',height:800,border:'1px solid #ddd'}}/>}</main>;
}
