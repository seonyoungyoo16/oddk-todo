    const beforeConflict=JSON.stringify(await read());chooseFile({...imported,title:'Conflicting snapshot'});await wait(()=>Boolean(doc().querySelector('dialog[open] input[type="checkbox"]')),'Conflicting import preview');doc().querySelector<HTMLInputElement>('dialog[open] input[type="checkbox"]')!.click();await click('기존 실적 백업 후 가져오기');await wait(()=>doc().querySelector('dialog[open]')!.textContent!.includes('같은 ID'),'Conflicting restore not rejected');if(JSON.stringify(await read())!==beforeConflict)throw Error('Conflicting restore changed original');await click('실적 가져오기 닫기');await wait(()=>!doc().querySelector('dialog[open]'),'Import conflict close');say('PASS real file preview and native restore preserve existing records; conflicting snapshot rolls back');
