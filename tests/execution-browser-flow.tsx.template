    await wait(()=>!doc().querySelector<HTMLInputElement>('dialog[open] input[type="checkbox"]')!.disabled,'Valid correction preview');
    doc().querySelector<HTMLInputElement>('dialog[open] input[type="checkbox"]')!.click();await click('실제 기록 저장');
    await wait(async()=>(await read()).records.find(r=>r.id===manual.id)?.endedAt!==manual.endedAt,'Correction did not commit');await wait(()=>!doc().querySelector('dialog[open]'),'Correction close');
    [...doc().querySelectorAll<HTMLButtonElement>('.oddk-recordHistory li button')].at(-1)!.click();await wait(()=>Boolean(doc().querySelector('dialog[open]')),'Reopen correction');
    if(doc().querySelector('dialog[open]')!.textContent!.includes('다른 창에서'))throw Error('Successful correction left stale draft');say('PASS future correction rejected, valid correction saved, reopening keeps current draft snapshot');
    const preservedInput=doc().querySelectorAll<HTMLInputElement>('dialog[open] input[type="datetime-local"]')[1].value;
    await localExecutionTransaction(value=>({...value,revision:value.revision+1,records:value.records.map(r=>r.id===manual.id?correctExecution(r,r.segments.map((s,i)=>i===r.segments.length-1?{...s,end:new Date(Date.parse(s.end!)-1000).toISOString()}:s),new Date().toISOString()):r)}));
    const remote=JSON.stringify((await read()).records.find(r=>r.id===manual.id));
    doc().querySelector<HTMLInputElement>('dialog[open] input[type="checkbox"]')!.click();await click('실제 기록 저장');await wait(()=>doc().querySelector('dialog[open]')!.textContent!.includes('다른 창에서 시간 기록 상태'),'Remote revision not rejected');
    if(JSON.stringify((await read()).records.find(r=>r.id===manual.id))!==remote||doc().querySelectorAll<HTMLInputElement>('dialog[open] input[type="datetime-local"]')[1].value!==preservedInput)throw Error('Conflict overwrote draft or remote record');
    await click('현재 상태 기준으로 새로 조작');await click('이전 입력 백업하고 최신 기록으로 시작');await click('입력 보관하고 닫기');await wait(()=>!doc().querySelector('dialog[open]'),'Reopened correction close');say('PASS changed record revision rejects stale correction, preserving both draft and remote interval');
    // Completion/undo uses the real plan UI and IndexedDB reconciliation.
