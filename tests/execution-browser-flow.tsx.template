    const correction=[...doc().querySelectorAll<HTMLInputElement>('dialog[open] input[type="datetime-local"]')];
    input(correction[1],koreanExecutionInput(new Date(Date.now()+3600000).toISOString()));await wait(()=>Boolean(button('실제 기록 저장')?.disabled),'Future interval admitted');
