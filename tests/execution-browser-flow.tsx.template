    await click('같은 요청으로 결과 확인');await wait(async()=>(await read()).records.some(r=>r.endedAt===null),'Retry failed');await click('기록 종료');await wait(async()=>(await read()).records.every(r=>r.endedAt!==null),'Retry stop');say('PASS native write failure preserves history; explicit same-request retry commits once');
    const pastEnd=new Date(Date.now()-3*86400000).toISOString(),pastStart=new Date(Date.parse(pastEnd)-600000).toISOString(),imported=manualExecution(plan.tasks[0],crypto.randomUUID(),[{kind:'work',start:pastStart,end:pastEnd}],new Date().toISOString());
    const chooseFile=(record:typeof imported)=>{const fileWindow=doc().defaultView as Window&typeof globalThis,transfer=new fileWindow.DataTransfer();transfer.items.add(new fileWindow.File([JSON.stringify({type:'oddk-executions',schemaVersion:1,exportedAt:new Date().toISOString(),records:[record]})],'synthetic-local-actuals.json',{type:'application/json'}));const input=doc().querySelector<HTMLInputElement>('input[type="file"]')!;input.files=transfer.files;input.dispatchEvent(new Event('change',{bubbles:true}));};
